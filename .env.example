# Server-only WeChat credentials. Never expose these to the browser.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=观澜 ESG Compass

# Admin console password. Required in every environment.
ADMIN_PASSWORD=

# Optional LLM scoring credential.
LLM_API_KEY=

# Optional. The article body is sent directly to WeChat; a public page is not
# required. Set this only when the "阅读原文" link should point to a public page.
WECHAT_ARTICLE_SOURCE_URL=

# dry_run | draft_only | auto_publish
WECHAT_PUBLISH_MODE=dry_run

# Optional shared secret for an external HTTP scheduler. Windows Task Scheduler
# runs the local publishing CLI directly and does not need this value.
WECHAT_CRON_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
CRON_SECRET=

# Optional callback verification. The publishing state is still polled via freepublish/get.
WECHAT_CALLBACK_TOKEN=
WECHAT_CALLBACK_AES_KEY=

# Optional API proxy. Leave empty for the official WeChat endpoint.
WECHAT_API_BASE_URL=

# File state is suitable for local development or a persistent/serverful deployment.
# Vercel serverless requires an external database/KV before production use.
WECHAT_STATE_BACKEND=file
